+#ifdef __ANDROID__
+/* Android X servers (e.g. GameNative's) have neither XComposite nor child clipping and draw
+ * a window's presented content even when an ancestor is unmapped, so other process surfaces
+ * created under the dummy parent show up at the screen origin. Instead, create them as
+ * mapped override-redirect toplevels far outside the screen and let
+ * X11DRV_client_surface_present copy their contents into the target window. */
+#define ANDROID_OPWR_OFFSCREEN_POS (-16384)
+#endif
+
 static void client_surface_update_geometry( HWND hwnd, struct x11drv_client_surface *surface )
 {
     UINT dpi = surface->raw ? NtUserGetWinMonitorDpi( hwnd, MDT_WINE_RAW_DPI ) : NtUserGetDpiForWindow( hwnd );
